{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && tsc-alias",
    "start": "node dist/server.js",
    "studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "seed": "tsx src/scripts/seed-owner.ts",
    "seed:prod": "node dist/scripts/seed-owner.js",
    "bench:ci": "tsx src/scripts/benchmark-ci.ts",
    "bench:bank": "tsx src/scripts/bank-benchmark-ci.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "@fastify/cookie": "^9.0.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@jottape/finance-engine": "workspace:^",
    "@jottape/schemas": "workspace:*",
    "@prisma/client": "^5.13.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.26.2",
    "node-cron": "^3.0.3",
    "rrule": "^2.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.25",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import-helpers": "^2.0.1",
    "prisma": "^5.13.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
