# Postgres local: `docker compose up -d` na raiz.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jottape?schema=public"
# Banco dos e2e (o nome precisa terminar em _test; o setup apaga e recria).
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/jottape_test?schema=public"
PORT=3333
# Origens aceitas pelo CORS, separadas por vírgula (o dev do Vite).
FRONTEND_URL="http://localhost:5173"
# Endereço público do app (o web). O Google volta para ${APP_URL}/api/google/callback.
APP_URL="http://localhost:5173"
# Atrás do proxy do Railway.
TRUST_PROXY=false

# Dono do app (uso pessoal): o seed cria este usuário. A senha só vale na criação.
OWNER_EMAIL="voce@gmail.com"
OWNER_PASSWORD="troque-esta-senha"
OWNER_NAME="André"
# Código de convite do cadastro (tela "Criar conta"). Sem ele, o cadastro fica fechado.
SIGNUP_CODE=""

# Obrigatórias em produção. Gere com: openssl rand -hex 32
JWT_SECRET=""
ENCRYPTION_KEY=""

# Google (Calendar, Tasks e login). Sem elas o app funciona sem Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Assistente. Sem ANTHROPIC_API_KEY a aba some; sem JEV_API_KEY nada salva sozinho; sem
# OPENAI_API_KEY o microfone usa a voz do navegador.
ANTHROPIC_API_KEY=""
JEV_API_KEY=""
OPENAI_API_KEY=""
ASSISTANT_MONTHLY_LIMIT=300
# Além do dono, quem usa o Assistente (e-mails separados por vírgula).
ASSISTANT_EMAILS=""

# Notificações (Web Push). Gere com: pnpm --filter api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@gmail.com"
